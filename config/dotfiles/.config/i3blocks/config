# i3blocks: Dracula status bar (FreidoraHeadless)
#
# Every block uses an inline command: Fedora's i3blocks package ships no
# blocklets in /usr/share/i3blocks.

separator_block_width=12
markup=pango

[ghostty]
full_text= Ghostty
command=setsid ghostty >/dev/null 2>&1
color=#50FA7B
separator=false

[vscode]
full_text= Code
command=setsid code-insiders >/dev/null 2>&1
color=#50FA7B

[public-ip]
label= 
command=curl -4 -s ifconfig.me
color=#6272A4
interval=once
separator=false

[ip_local]
label= 
command=hostname -I | awk '{print $1}'
color=#6272A4
interval=60

[cpu_usage]
label= 
command=top -bn1 | awk '/^%Cpu/ {printf "%.0f%%\n", 100 - $8}'
color=#F1FA8C
interval=10
separator=false

[load_average]
label= 
command=cut -d' ' -f1 /proc/loadavg
color=#F1FA8C
interval=10
separator=false

[temperature]
label= 
command=for h in /sys/class/hwmon/hwmon*; do [ "$(cat "$h/name")" = k10temp ] && awk '{printf "%.0f°C\n", $1 / 1000}' "$h/temp1_input"; done
color=#F1FA8C
interval=10

[memory]
label= 
command=free -h | awk '/^Mem/ {print $3 "/" $2}'
color=#FFB86C
interval=30
separator=false

[swap]
label= 
command=free -h | awk '/^Swap/ {print $3 "/" $2}'
color=#FFB86C
interval=30

[disk]
label= 
command=df -h / | awk 'NR == 2 {print $4}'
color=#FF79C6
interval=30

[time]
command=date '+%D %T'
color=#BD93F9
interval=5
separator=false

[weather]
label=☀️ 
command=curl -Ss 'https://wttr.in?0&T&Q' | cut -c 16- | head -2 | tail -1 | xargs echo
color=#BD93F9
interval=3600

[restart]
full_text=⏻ 
command=i3-msg -q restart
color=#F8F8F2
