---
# Copy to hosts.yml (ignored by Git). `terraform output -raw ansible_inventory`
# in infra/terraform/vm-macos prints a ready-made version.
vm:
  hosts:
    freidora-vm:
      ansible_host: 127.0.0.1
      ansible_port: 2222
      ansible_user: tu_usuario
      ansible_ssh_private_key_file: ~/.ssh/tu_llave
      # Optional: password for RDP logins (SSH stays key-only).
      # Generate the hash with: openssl passwd -6
      # freidora_user_password_hash: "$6$..."
